{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "eslint", "oxc", "import"],
    "categories": {
        "correctness": "error"
    },
    "env": {
        "browser": true,
        "es2024": true
    },
    "ignorePatterns": ["dist/**", "node_modules/**"],
    "rules": {
        "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
        "typescript/no-explicit-any": "warn"
    }
}
