{
    "name": "lovelace-better-xiaomi-vacuum-map-card",
    "version": "1.0.0",
    "description": "Better Xiaomi Vacuum Map Card",
    "keywords": [
        "home-assistant",
        "homeassistant",
        "hass",
        "lovelace",
        "custom-cards",
        "vacuum",
        "map-card",
        "xiaomi",
        "roborock",
        "valetudo",
        "hacs"
    ],
    "module": "xiaomi-vacuum-map-card.js",
    "repository": "https://github.com/Igloczek/lovelace-better-xiaomi-vacuum-map-card.git",
    "homepage": "https://github.com/Igloczek/lovelace-better-xiaomi-vacuum-map-card",
    "bugs": {
        "url": "https://github.com/Igloczek/lovelace-better-xiaomi-vacuum-map-card/issues"
    },
    "author": "Bartek Igielski <igloczek@gmail.com> (https://github.com/Igloczek)",
    "contributors": [
        "Piotr Machowski <piotr.machowski.dev@gmail.com>"
    ],
    "license": "MIT",
    "dependencies": {
        "change-perspective": "^1.0.1",
        "custom-card-helpers": "^2.1.0",
        "home-assistant-js-websocket": "^9.8.1",
        "lit": "^3.3.3",
        "pointer-tracker": "^2.5.3",
        "transformation-matrix": "^3.1.0"
    },
    "devDependencies": {
        "@playwright/test": "1.65.0",
        "@types/node": "^26.6.6",
        "@types/pngjs": "^6.0.5",
        "happy-dom": "^21.0.4",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "pngjs": "^7.0.0",
        "rolldown": "^1.3.2",
        "rollup-plugin-serve": "^3.0.0",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    },
    "scripts": {
        "start": "rolldown -c rolldown.config.dev.mjs --watch",
        "build": "npm run lint && npm run bundle && npm run add-version",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:visual": "playwright test",
        "test:visual:update": "playwright test --update-snapshots",
        "check:map-scale": "vitest run test/map-scale.test.ts",
        "check:docs": "node scripts/check-docs-links.cjs",
        "add-version": "node scripts/add-version.mjs",
        "lint": "oxlint src",
        "test:e2e": "playwright test -c test/e2e/playwright.config.ts",
        "e2e:install": "node test/e2e/marketplace-install.cjs",
        "bundle": "rolldown -c rolldown.config.mjs",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "engines": {
        "node": ">=22.12"
    }
}
