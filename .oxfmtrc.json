{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "semi": true,
    "trailingComma": "all",
    "singleQuote": false,
    "printWidth": 120,
    "tabWidth": 4,
    "bracketSameLine": true,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "embeddedLanguageFormatting": "off",
    "sortPackageJson": false,
    "ignorePatterns": ["dist", ".vscode", ".devcontainer", "package-lock.json", "*.md", "*.yaml", "*.yml", "*.txt"]
}
